<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The Hunter's Crescent (DESIGN.md §2.1): crescent moon = Artemis bow,
         negative space = magnifying lens. Moon Silver on Void Black, with a
         Hunt Crimson crosshair at the focal point. -->
    <!-- Crescent: outer arc (r=27 @ 50,52) minus inner arc (r=21 @ 60,46) -->
    <path
        android:fillColor="#C8C9D0"
        android:fillType="nonZero"
        android:pathData="M55.32,25.53 A27,27 0 1,0 75.86,59.77 A21,21 0 1,1 55.32,25.53 Z" />
    <!-- Crosshair ticks (Ghost Line: 1.5 stroke, rounded caps) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M66,32 L66,40 M66,48 L66,56 M58,40 L66,40 M66,40 L74,40"
        android:strokeColor="#B8323A"
        android:strokeLineCap="round"
        android:strokeWidth="1.5" />
    <!-- Focal dot -->
    <path
        android:fillColor="#B8323A"
        android:pathData="M64.5,38.5 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0" />
</vector>
