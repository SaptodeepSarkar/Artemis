<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is forbidden everywhere except the phone's own loopback
    interface, where the in-app UI talks to the embedded server
    (http://127.0.0.1:8443 — pairing-code regeneration and dashboard
    management). Every network-facing connection is TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
